    "format:check": "prettier --check \"src/**/*.{ts,css}\""
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "lucide": "^0.471.0",
    "tailwindcss": "^4.1.18"
  }
}
